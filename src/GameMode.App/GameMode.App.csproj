<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\design\game-mode.ico</ApplicationIcon>
    <AssemblyName>GameMode</AssemblyName>
    <RootNamespace>GameMode.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- 发版时 tools/release.ps1 会自动改这一行，CI 则用 -p:Version= 覆盖 -->
    <Version>1.1.1</Version>

    <!-- 体积换内存：只保留工作站 GC，关掉服务端 GC 与 ReadyToRun 带来的预热内存 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- 单文件发布时不生成调试符号，app 目录只留 exe -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameMode.Core\GameMode.Core.csproj" />
  </ItemGroup>

</Project>
